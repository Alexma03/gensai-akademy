---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/atoms/Badge.astro';
import Button from '../../components/atoms/Button.astro';
import Icon from '../../components/atoms/Icon.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const CATEGORY_META = {
  geniotipo: { label: 'Geniotipo', tone: 'green' as const, href: '/geniotipo', cta: 'Conoce el recorrido Geniotipo' },
  'altas-capacidades-familias': { label: 'AACC familias', tone: 'pink' as const, href: '/altas-capacidades-familias', cta: 'Conoce el acompañamiento para familias' },
  'altas-capacidades-adultos': { label: 'AACC adultos', tone: 'green' as const, href: '/altas-capacidades-adultos', cta: 'Conoce el coaching para adultos' },
};

const meta = CATEGORY_META[post.data.category];
const dateLabel = post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: 'Mary Garzón', url: 'https://gensai-akademy.alex03marcos.workers.dev/sobre-mi' },
  publisher: { '@type': 'Organization', name: 'Gensai Akademy', url: 'https://gensai-akademy.alex03marcos.workers.dev' },
  inLanguage: 'es',
};
---

<BaseLayout title={`${post.data.title} | Mary Garzón`} description={post.data.description} canonicalPath={`/blog/${post.id}`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <header class="page-hero pb-14 pt-24 sm:pt-28">
    <div class="page-container max-w-3xl text-center">
      <Badge tone={meta.tone}>{meta.label}</Badge>
      <h1 class="hero-enter mt-6 text-4xl leading-[1.12] tracking-[-0.015em] sm:text-5xl">{post.data.title}</h1>
      <p class="hero-enter hero-enter-delay-1 mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-brand-quiet">
        <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={15} /> {dateLabel}</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={15} /> {post.data.minutes} min de lectura</span>
        <a href="/sobre-mi" class="font-semibold text-brand-green-accessible underline underline-offset-4">Por Mary Garzón</a>
      </p>
    </div>
  </header>

  <article class="bg-white py-14 sm:py-16">
    <div class="page-container max-w-3xl prose-gensai"><Content /></div>
  </article>

  <section class="bg-white pb-20">
    <div class="page-container max-w-3xl">
      <div class="rounded-2xl border border-brand-line bg-brand-pond p-7 text-center sm:p-10">
        <h2 class="text-2xl sm:text-3xl">¿Quieres conocer el siguiente paso?</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-brand-quiet sm:text-base">Explora el acompañamiento relacionado con este artículo y comprueba si encaja con lo que necesitas.</p>
        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href={meta.href} variant="pink" arrow>{meta.cta}</Button>
          <Button href="/blog" variant="ghost">Volver al blog</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

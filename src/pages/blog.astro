---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/molecules/BlogCard.astro';
import PageHero from '../components/molecules/PageHero.astro';

const CATEGORY_META = {
  geniotipo: { label: 'Geniotipo', accent: 'green' as const },
  'altas-capacidades-familias': { label: 'AACC adolescentes', accent: 'pink' as const },
  'altas-capacidades-adultos': { label: 'AACC adultos', accent: 'green' as const },
};

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const formatDate = (date: Date) => date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Blog sobre Geniotipo y altas capacidades | Mary Garzón"
  description="Artículos de Mary Garzón sobre orientación vocacional para adolescentes, Geniotipo, familias y adultos con altas capacidades."
  canonicalPath="/blog"
>
  <PageHero badge="Blog" tone="pink" description="Contenido para comprender mejor el talento, acompañar las altas capacidades y tomar decisiones con más claridad.">
    Preguntas reales, respuestas <span class="font-normal italic text-brand-green-accessible">útiles</span>
  </PageHero>

  <section class="bg-white py-16 sm:py-20">
    <div class="page-container">
      <div class="grid gap-5 md:grid-cols-2">
        {posts.map((post) => {
          const meta = CATEGORY_META[post.data.category];
          return (
            <BlogCard
              letter={meta.label.charAt(0)}
              category={meta.label}
              title={post.data.title}
              excerpt={post.data.description}
              date={formatDate(post.data.pubDate)}
              time={`${post.data.minutes} min`}
              href={`/blog/${post.id}`}
              accent={meta.accent}
            />
          );
        })}
      </div>
      <p class="mx-auto mt-12 max-w-2xl text-center text-sm leading-relaxed text-brand-quiet">El blog crecerá con nuevos contenidos cuando aporten una respuesta diferente y útil. No publicamos artículos solo para repetir keywords.</p>
    </div>
  </section>
</BaseLayout>

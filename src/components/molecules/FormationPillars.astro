---
import Button from '../atoms/Button.astro';

interface Props {
  intro?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const pillars = [
  {
    slug: 'geniotipo',
    title: 'Geniotipo',
    credential: 'Máster en Geniotipo y Certificación en Psicogenium',
    text: 'Especializándome en el diagnóstico avanzado del talento, la arquitectura de la esencia de las personas y las claves de esta potente herramienta de autoconocimiento.',
  },
  {
    slug: 'inteligencia-emocional',
    title: 'Inteligencia Emocional',
    credential: 'Experto Universitario en Inteligencia Emocional',
    text: 'Para sanar mi propia sensibilidad y dominar herramientas de autorregulación emocional.',
  },
  {
    slug: 'altas-capacidades',
    title: 'Altas Capacidades',
    credential: 'Máster en Altas Capacidades y Desarrollo del Talento',
    text: 'Profundizando en la neurodiversidad, sobreexcitabilidades y necesidades socioemocionales en perfiles de AACC.',
  },
];

const {
  intro = 'Para ofrecer un acompañamiento riguroso y profesional, consolidé mi experiencia con una sólida preparación académica de posgrado.',
  ctaHref = '/sobre-mi#formacion',
  ctaLabel = 'Ver credenciales verificables',
} = Astro.props;
---

<div>
  {intro && (
    <p class="mx-auto max-w-3xl text-center text-sm leading-relaxed text-brand-quiet sm:text-[15px]">{intro}</p>
  )}
  <ul class="mx-auto mt-10 grid max-w-5xl gap-12 sm:grid-cols-3 sm:gap-8 lg:gap-12">
    {pillars.map((pillar) => (
      <li class="text-center">
        <picture>
          <source srcset={`/icons/${pillar.slug}.webp`} type="image/webp" />
          <img
            src={`/icons/${pillar.slug}.png`}
            alt=""
            width="512"
            height="512"
            loading="lazy"
            decoding="async"
            class="mx-auto size-28 object-contain sm:size-32"
          />
        </picture>
        <h3 class="mt-5 text-2xl">{pillar.title}</h3>
        <p class="mt-2 text-xs font-semibold leading-relaxed text-brand-green-accessible">{pillar.credential}</p>
        <p class="mt-3 text-sm leading-relaxed text-brand-quiet">{pillar.text}</p>
      </li>
    ))}
  </ul>
  {ctaHref && (
    <div class="mt-10 text-center">
      <Button href={ctaHref} variant="ghost" arrow>{ctaLabel}</Button>
    </div>
  )}
</div>

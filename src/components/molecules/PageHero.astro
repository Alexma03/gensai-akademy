---
import Badge from '../atoms/Badge.astro';

interface Props {
  badge: string;
  description: string;
  tone?: 'green' | 'pink' | 'orange' | 'violet';
  backgroundSrc?: string;
  backgroundPosition?: string;
}

const { badge, description, tone = 'green', backgroundSrc, backgroundPosition = 'center 40%' } = Astro.props;
---

<header
  class:list={[
    'page-hero border-b border-brand-line pt-24 pb-14 sm:pt-28 sm:pb-16',
    backgroundSrc && 'page-hero--photo relative overflow-hidden',
  ]}
>
  {backgroundSrc && (
    <>
      <img
        src={backgroundSrc}
        alt=""
        width="3000"
        height="1000"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 size-full object-cover transform-none"
        style={`object-position: ${backgroundPosition}; transform: none;`}
      />
      <div aria-hidden="true" class="page-hero-scrim pointer-events-none absolute inset-0"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#0d130d]/[0.06] backdrop-blur-[0.5px]"></div>
    </>
  )}
  <div class="page-container relative z-10 text-center">
    <Badge tone={tone} class:list={['hero-enter', backgroundSrc && 'page-hero-badge !text-white']}>{badge}</Badge>
    <h1
      class:list={[
        'hero-enter hero-enter-delay-1 mx-auto mt-6 max-w-3xl text-4xl font-medium leading-[1.08] tracking-[-0.02em] sm:text-5xl lg:text-[3.5rem]',
        !backgroundSrc && 'text-brand-ink',
      ]}
    >
      <slot />
    </h1>
    <p
      class:list={[
        'hero-enter hero-enter-delay-2 mx-auto mt-5 max-w-2xl text-balance text-base leading-relaxed sm:text-lg',
        !backgroundSrc && 'text-brand-quiet',
      ]}
    >
      {description}
    </p>
  </div>
</header>

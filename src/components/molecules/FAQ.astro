---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Preguntas frecuentes' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="bg-white py-20 sm:py-24" aria-labelledby="faq-heading">
  <div class="page-container max-w-3xl">
    <h2 id="faq-heading" class="text-center font-serif text-3xl font-medium leading-tight tracking-[-0.015em] text-brand-ink sm:text-4xl">{heading}</h2>
    <div class="mt-10 divide-y divide-brand-line overflow-hidden rounded-2xl border border-brand-line bg-white">
      {items.map((item) => (
        <details class="group px-6 py-5 sm:px-7">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-base font-medium leading-snug text-brand-ink transition-colors group-open:text-brand-green-accessible sm:text-lg [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="grid size-7 shrink-0 place-items-center rounded-full border border-brand-line bg-brand-mist text-brand-green-accessible transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="size-3.5"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-brand-quiet sm:text-[15px]">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</section>

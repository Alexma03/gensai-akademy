---
import Icon from '../atoms/Icon.astro';

interface Props {
  letter: string;
  category: string;
  title: string;
  excerpt: string;
  date: string;
  time: string;
  href: string;
  accent?: 'green' | 'pink';
  orientation?: 'vertical' | 'horizontal';
}

const {
  letter,
  category,
  title,
  excerpt,
  date,
  time,
  href,
  accent = 'green',
  orientation = 'vertical',
} = Astro.props;

const pink = accent === 'pink';
---

<article class:list={[
  'group overflow-hidden rounded-2xl border border-brand-line bg-white transition-colors hover:border-brand-green/20',
  orientation === 'horizontal' ? 'md:flex' : 'flex h-full flex-col',
]}>
  <div class:list={[
    'grid shrink-0 place-items-center border-b border-brand-line',
    pink ? 'bg-brand-pink/8' : 'bg-brand-green/8',
    orientation === 'horizontal' ? 'min-h-52 md:w-2/5 md:border-b-0 md:border-r' : 'h-40',
  ]}>
    <span class:list={[
      'grid size-16 place-items-center rounded-full border text-2xl font-medium',
      pink ? 'border-brand-pink/15 bg-white text-brand-pink-accessible' : 'border-brand-green/15 bg-white text-brand-green-accessible',
    ]}>{letter}</span>
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <span class:list={[
      'w-fit rounded-full border px-3 py-1 text-xs font-semibold',
      pink ? 'border-brand-pink/15 bg-brand-pink/10 text-brand-pink-accessible' : 'border-brand-green/15 bg-brand-green/10 text-brand-green-accessible',
    ]}>{category}</span>
    <h2 class:list={[
      'mt-4 font-serif font-medium leading-tight text-brand-ink transition-colors group-hover:text-brand-green-accessible',
      orientation === 'horizontal' ? 'text-2xl' : 'text-xl',
    ]}>
      <a href={href} class="focus-visible:rounded-sm">{title}</a>
    </h2>
    <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-brand-quiet">{excerpt}</p>
    <div class="mt-auto flex flex-wrap items-center gap-4 pt-5 text-xs text-brand-quiet">
      <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={13} /> {date}</span>
      <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={13} /> {time}</span>
    </div>
    {orientation === 'vertical' && (
      <a href={href} class:list={['mt-5 inline-flex w-fit items-center gap-1 text-sm font-medium', pink ? 'text-brand-pink-accessible' : 'text-brand-green-accessible']}>
        Leer más <Icon name="arrow-right" size={14} />
      </a>
    )}
  </div>
</article>

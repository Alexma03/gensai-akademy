---
interface Props {
  calLink: string;
  namespace: string;
  layout?: 'month_view' | 'week_view' | 'column_view';
}

const { calLink, namespace, layout = 'month_view' } = Astro.props;
const elementId = `my-cal-inline-${namespace}`;
const bookingUrl = `https://cal.com/${calLink}`;
---

<div
  id={elementId}
  class="cal-inline-embed min-h-[44rem] w-full overflow-auto rounded-2xl bg-white"
  data-cal-namespace={namespace}
  aria-label="Calendario de reserva"
></div>
<noscript>
  <p class="mt-4 text-sm leading-relaxed text-brand-quiet">
    Para reservar, abre el calendario en
    <a class="font-semibold text-brand-green-accessible underline-offset-2 hover:underline" href={bookingUrl}>
      {bookingUrl}
    </a>.
  </p>
</noscript>

<script is:inline define:vars={{ calLink, namespace, elementId, layout }}>
  (function (C, A, L) {
    var p = function (a, ar) {
      a.q.push(ar);
    };
    var d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        var cal = C.Cal;
        var ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          var api = function () {
            p(api, arguments);
          };
          var initNamespace = ar[1];
          api.q = api.q || [];
          if (typeof initNamespace === 'string') {
            cal.ns[initNamespace] = cal.ns[initNamespace] || api;
            p(cal.ns[initNamespace], ar);
            p(cal, ['initNamespace', initNamespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', namespace, { origin: 'https://app.cal.com' });
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;

  Cal.ns[namespace]('inline', {
    elementOrSelector: '#' + elementId,
    config: { layout: layout, useSlotsViewOnSmallScreen: 'true' },
    calLink: calLink,
  });

  Cal.ns[namespace]('ui', {
    hideEventTypeDetails: false,
    layout: layout,
    theme: 'light',
    cssVarsPerTheme: {
      light: {
        'cal-brand': '#3F741F',
        'cal-brand-emphasis': '#2F5817',
        'cal-brand-text': '#FFFFFF',
        'cal-bg': '#FFFFFF',
        'cal-bg-muted': '#F4F8F0',
        'cal-border-booker': '#E3E9DD',
        'cal-border-booker-width': '1px',
        radius: '0.75rem',
      },
    },
  });
</script>
